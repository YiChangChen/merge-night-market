# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files（app.config.ts 從環境變數讀 PostHog、Sentry、AdMob 金鑰）
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

